<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4F46E5</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppTheme.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4F46E5</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cloudvault</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
