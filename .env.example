# CloudVault Environment Variables

# --- Database ---
# For Local SQLite (Default for quick local development without Postgres):
# DATABASE_URL=sqlite:///./cloudvault.db

# For PostgreSQL (Production & Docker):
DATABASE_URL=postgresql+psycopg://cloudvault:cloudvault_secure_pass_123@localhost:5432/cloudvault
POSTGRES_USER=cloudvault
POSTGRES_PASSWORD=cloudvault_secure_pass_123
POSTGRES_DB=cloudvault

# --- Security & JWT Auth ---
# Generate a secure 64-character hex key in production: openssl rand -hex 32
APP_SECRET=change_this_to_a_super_secret_key_at_least_32_characters_long
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage Engine ---
# Options: 'local' (filesystem) or 's3' (AWS S3, MinIO, Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data

# --- S3 / MinIO Configuration (Required if STORAGE_BACKEND=s3) ---
S3_BUCKET=cloudvault-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
# For MinIO or Cloudflare R2, specify custom endpoint:
# S3_ENDPOINT_URL=http://localhost:9000

# --- Quotas and Limits ---
DEFAULT_STORAGE_QUOTA_BYTES=5368709120  # 5 GB
MAX_UPLOAD_SIZE_BYTES=104857600         # 100 MB per file

# --- CORS & Networking ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
